{
  "name": "@gxx-labs/session-manager-dsh",
  "version": "0.1.2",
  "description": "DSH 插件：设置 →「会话管理」页签，批量管理已归档会话（批量取消归档 / 批量归档 / 彻底删除会话及其磁盘文件）。UI 复用 DSH 设计令牌与 primitives。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./dist/client.js",
    "./paths": "./lib/paths.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "seed": "node scripts/fetch-host-seed.mjs && node scripts/build-host-seed.mjs",
    "test": "node scripts/run-tests.mjs",
    "verify": "node scripts/verify-bundle.mjs",
    "dry-run": "node scripts/dry-run.mjs",
    "check": "node scripts/build-client.mjs && node scripts/verify-bundle.mjs && node scripts/run-tests.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "session",
    "archive",
    "settings"
  ],
  "author": "guoxiaoxi",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "0.25.12",
    "anser": "^2.3.5",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "esbuild": "0.25.12",
    "immer": "^11.1.21",
    "jsdom": "^30.1.2",
    "katex": "^0.19.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-core-commonmark": "^2.0.4",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-factory-space": "^2.1.0",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-sanitize-uri": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "shiki": "^4.5.0",
    "simple-icons": "16.31.0",
    "zustand": "^5.0.15"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "react"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gxx950224/dsh-session-manager.git"
  },
  "homepage": "https://github.com/gxx950224/dsh-session-manager#readme",
  "bugs": {
    "url": "https://github.com/gxx950224/dsh-session-manager/issues"
  }
}
